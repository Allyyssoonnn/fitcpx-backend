{
   "compilerOptions": {
      "target": "ES2020", // versão do JS gerada
      "module": "commonjs", // Node usa CommonJS
      "rootDir": ".", // onde estão os arquivos TS
      "outDir": "./dist", // onde vai gerar JS
      "strict": true, // ativa checagem rigorosa
      "esModuleInterop": true, // importa módulos CommonJS facilmente
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,
      "allowJs": true
   },
   "include": ["**/*.ts"],
   "exclude": ["node_modules"]
}
