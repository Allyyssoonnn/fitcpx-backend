# FitCPX Backend - example environment configuration
# Copy to .env and provide your own development credentials.
# Never commit .env files containing real secrets.

# ------------------------------------------------------------
# Application & authentication
# ------------------------------------------------------------
NODE_ENV=development
# JWT signing secret (generate a unique, high-entropy value)
SECRET=
# Development-only authentication token; never enable in production
DEV_TOKEN=

# ------------------------------------------------------------
# AWS services
# ------------------------------------------------------------
ACCESS_KEY_AWS=
SECRET_KEY_AWS=

# ------------------------------------------------------------
# Payments - Asaas
# ------------------------------------------------------------
ASAAS_KEY_DEVELOPMENT=
ASAAS_KEY_PRODUCTION=

# ------------------------------------------------------------
# Document signing - Autentique
# ------------------------------------------------------------
AUTENTIQUE_KEY=
AUTENTIQUE_SECRET_WEBHOOK=

# ------------------------------------------------------------
# AI services
# ------------------------------------------------------------
OPENAI_API_KEY=

# ------------------------------------------------------------
# Google integrations (not the Firebase service-account JSON file)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_KEY=

# ------------------------------------------------------------
# Email integrations
# ------------------------------------------------------------
MAILTRAP_TOKEN=
MAILTRAP_SANDBOX_TOKEN=
# Legacy integration documented in docs/.env-example
SENDGRID_KEY=
